# Base de datos PostgreSQL
DATABASE_URL="postgresql://sifoin:sifoin_dev_password@localhost:5433/sifoin?schema=public"
DATABASE_URL_TEST="postgresql://sifoin:sifoin_test_password@localhost:5434/sifoin_test?schema=public"

# Seguridad
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-en-produccion"
SESSION_TTL_HOURS=8
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# URL pública del frontend (para enlaces en correos)
PUBLIC_APP_URL="http://localhost:3000"

# Correo SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SIFOIN <no-responder@colmayor.edu.co>"

# Semilla inicial del Super Administrador (solo primer arranque)
SEED_ADMIN_EMAIL="admin@colmayor.edu.co"
SEED_ADMIN_PASSWORD=""

# Zona horaria institucional (documentada; el código la fija en America/Bogota)
TZ=America/Bogota

# Jobs
OUTBOX_POLL_MS=15000
QR_JOB_POLL_MS=30000
FINALIZA_JOB_POLL_MS=600000
RECORDATORIO_JOB_POLL_MS=300000
